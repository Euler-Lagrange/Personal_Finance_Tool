{
  "name": "personal-finance-tool",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "tsc --noEmit",
    "test:ui": "playwright test",
    "build:desktop": "tauri build --no-bundle",
    "predev": "node scripts/prepare-pdf-assets.mjs",
    "prebuild": "node scripts/check-release-version.mjs && node scripts/prepare-pdf-assets.mjs",
    "check:release": "node scripts/check-release-version.mjs",
    "build:installer": "tauri build --bundles nsis",
    "docs:refresh": "node scripts/refresh-review-packet.mjs",
    "docs:check": "node scripts/refresh-review-packet.mjs --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
